# Discord
DISCORD_TOKEN=

# 개발/개인 서버에서는 guild id를 넣으면 slash command 반영이 빠릅니다.
# 비워두면 global command로 등록되어 반영까지 시간이 걸릴 수 있습니다.
DISCORD_GUILD_ID=

# 쉼표로 여러 개 입력 가능합니다. 예: 123,456
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_ROLE_IDS=

# true로 두면 Discord 서버 관리자도 명령을 쓸 수 있습니다.
ALLOW_DISCORD_ADMINS=false

# Minecraft server
MINECRAFT_SERVER_DIR=C:\minecraft\server
MINECRAFT_START_COMMAND=java -Xms2G -Xmx4G -jar server.jar nogui
MINECRAFT_LOG_FILE=bot-server.log
STARTUP_CHECK_SECONDS=90
SHUTDOWN_CHECK_SECONDS=45

# server.properties의 rcon 설정과 맞추세요.
MINECRAFT_RCON_HOST=127.0.0.1
MINECRAFT_RCON_PORT=25575
MINECRAFT_RCON_PASSWORD=change-me
